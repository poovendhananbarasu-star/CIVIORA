# Copy this file to ".env" and fill in your Firebase project's web config.
# Find these values in: Firebase Console > Project Settings > General > Your apps > SDK setup and configuration
#
# Until these are filled in, the site still builds and runs normally —
# the "Book an Appointment" form will simply show the direct email/phone
# contact details instead of submitting to Firestore.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Meta Pixel (optional, loaded only upon visitor consent)
VITE_META_PIXEL_ID=

# Microsoft Clarity (optional, loaded only upon visitor consent)
VITE_MICROSOFT_CLARITY_PROJECT_ID=

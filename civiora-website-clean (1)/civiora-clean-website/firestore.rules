rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    //
    // Collection: appointmentRequests
    // Document ID: auto-generated document ID (addDoc)
    // Fields:
    //   - institutionType: string (required, in allowed set)
    //   - representativeName: string (required, 1-150 chars)
    //   - designation: string (required, 1-150 chars)
    //   - institutionName: string (required, 1-200 chars)
    //   - location: string (required, 1-150 chars)
    //   - officialEmail: string (required, valid email pattern, 1-150 chars)
    //   - telephone: string (required, 5-50 chars)
    //   - requirement: string (required, 1-3000 chars)
    //   - discussionFormat: string (required, 1-100 chars)
    //   - consent: bool (required, must be true)
    //   - createdAt: timestamp (serverTimestamp or valid timestamp)
    //
    // Security Posture:
    //   - NO public read access under any circumstances.
    //   - NO public update or delete access under any circumstances.
    //   - Create only permitted with validated institutional fields.
    // ===============================================================

    // Deny all by default across all documents
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidEmail(email) {
      return email is string 
        && email.size() >= 5 
        && email.size() <= 150 
        && email.matches('.+@.+\\..+');
    }

    function isValidAppointmentRequest(data) {
      return data.keys().hasAll([
               'institutionType',
               'representativeName',
               'designation',
               'institutionName',
               'location',
               'officialEmail',
               'telephone',
               'requirement',
               'discussionFormat',
               'consent'
             ])
             && data.consent == true
             && data.representativeName is string
             && data.representativeName.size() > 0
             && data.representativeName.size() <= 150
             && data.designation is string
             && data.designation.size() > 0
             && data.designation.size() <= 150
             && data.institutionName is string
             && data.institutionName.size() > 0
             && data.institutionName.size() <= 200
             && data.location is string
             && data.location.size() > 0
             && data.location.size() <= 150
             && isValidEmail(data.officialEmail)
             && data.telephone is string
             && data.telephone.size() >= 5
             && data.telephone.size() <= 50
             && data.requirement is string
             && data.requirement.size() > 0
             && data.requirement.size() <= 3000
             && data.discussionFormat is string
             && data.discussionFormat.size() <= 100
             && data.institutionType in [
               'School',
               'College',
               'University',
               'Academic/Specialist Partner',
               'Other Institution'
             ];
    }

    match /appointmentRequests/{requestId} {
      // Public reading, modification, and deletion are strictly forbidden
      allow read, update, delete: if false;

      // Only allow creation of validated appointment/enquiry requests
      allow create: if isValidAppointmentRequest(request.resource.data);
    }
  }
}
